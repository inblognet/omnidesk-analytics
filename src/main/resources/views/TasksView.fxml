<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<VBox spacing="20" style="-fx-padding: 40; -fx-background-color: #0d1117;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.omnidesk.controllers.TasksController">

    <Label text="Task Management" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
    <Label text="Organize your workflow, update priorities, and mark tasks as complete." style="-fx-text-fill: gray; -fx-font-size: 14px;"/>

    <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: #161b22; -fx-padding: 20; -fx-background-radius: 8;">
        <TextField fx:id="titleField" promptText="Task Description" HBox.hgrow="ALWAYS" />
        <ComboBox fx:id="priorityComboBox" promptText="Priority" prefWidth="120" />
        <ComboBox fx:id="statusComboBox" promptText="Status" prefWidth="120" />

        <Button text="Add" styleClass="success" minWidth="70" onAction="#handleAddTask"/>
        <Button text="Update" styleClass="accent" minWidth="70" onAction="#handleUpdateTask"/>
        <Button text="Delete" styleClass="danger" minWidth="70" onAction="#handleDeleteTask"/>
    </HBox>

    <TableView fx:id="tasksTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn text="Task" prefWidth="450">
                <cellValueFactory><PropertyValueFactory property="title" /></cellValueFactory>
            </TableColumn>
            <TableColumn text="Priority" prefWidth="120">
                <cellValueFactory><PropertyValueFactory property="priority" /></cellValueFactory>
            </TableColumn>
            <TableColumn text="Status" prefWidth="120">
                <cellValueFactory><PropertyValueFactory property="status" /></cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>

</VBox>