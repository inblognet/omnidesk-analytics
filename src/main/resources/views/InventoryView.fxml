<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" style="-fx-padding: 40; -fx-background-color: #0d1117;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.omnidesk.controllers.InventoryController">

    <Label text="Inventory Management" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
    <Label text="Track your products and stock levels." style="-fx-text-fill: gray; -fx-font-size: 14px;"/>

    <HBox spacing="10">
        <TextField fx:id="nameField" promptText="Product Name" HBox.hgrow="ALWAYS" />
        <TextField fx:id="qtyField" promptText="Quantity (e.g. 50)" prefWidth="120" />
        <TextField fx:id="priceField" promptText="Price ($)" prefWidth="100" />

        <Button text="Add Item" styleClass="accent" onAction="#handleAddItem"/>
    </HBox>

    <Label text="Current Stock" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <ListView fx:id="inventoryListView" VBox.vgrow="ALWAYS" style="-fx-font-family: monospace; -fx-font-size: 14px;"/>

</VBox>