<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="30" style="-fx-padding: 40;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.omnidesk.controllers.DashboardController">

    <VBox spacing="5">
        <Label text="System Overview" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
        <Label text="Welcome back. Here is your daily productivity summary." style="-fx-text-fill: -color-fg-muted; -fx-font-size: 14px;"/>
    </VBox>

    <HBox spacing="20">

        <VBox style="-fx-background-color: -color-bg-subtle; -fx-padding: 20; -fx-background-radius: 8;" HBox.hgrow="ALWAYS">
            <Label text="Total Tasks" style="-fx-text-fill: -color-fg-muted; -fx-font-size: 14px;"/>
            <Label fx:id="lblTasks" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #58a6ff;"/>
        </VBox>

        <VBox style="-fx-background-color: -color-bg-subtle; -fx-padding: 20; -fx-background-radius: 8;" HBox.hgrow="ALWAYS">
            <Label text="Recorded Transactions" style="-fx-text-fill: -color-fg-muted; -fx-font-size: 14px;"/>
            <Label fx:id="lblFinance" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #3fb950;"/>
        </VBox>

        <VBox style="-fx-background-color: -color-bg-subtle; -fx-padding: 20; -fx-background-radius: 8;" HBox.hgrow="ALWAYS">
            <Label text="Most Used App Today" style="-fx-text-fill: -color-fg-muted; -fx-font-size: 14px;"/>
            <Label fx:id="lblApp" text="None" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #f0883e;"/>
        </VBox>

        <VBox style="-fx-background-color: -color-bg-subtle; -fx-padding: 20; -fx-background-radius: 8;" HBox.hgrow="ALWAYS">
            <Label text="Total Inventory Items" style="-fx-text-fill: -color-fg-muted; -fx-font-size: 14px;"/>
            <Label fx:id="lblInventory" text="0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #d2a8ff;"/>
        </VBox>

    </HBox>

    <Region VBox.vgrow="ALWAYS"/>

</VBox>