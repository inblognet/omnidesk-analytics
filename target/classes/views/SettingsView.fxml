<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="30" style="-fx-padding: 40; -fx-background-color: #0d1117;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.omnidesk.controllers.SettingsController">

    <VBox spacing="10">
        <Label text="System Settings" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>

        <VBox style="-fx-background-color: #161b22; -fx-padding: 20; -fx-background-radius: 8;">
            <Label text="OmniDesk Analytics" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #58a6ff;"/>
            <Label text="Version 1.0.0 - Standalone Offline Edition" style="-fx-text-fill: gray;"/>
            <Label wrapText="true" text="OmniDesk is a comprehensive, offline-first productivity suite. It features encrypted task management, financial ledgers, inventory tracking, and deep operating system integration to monitor app usage and search habits directly from your local hardware." style="-fx-padding: 10 0 0 0;"/>
        </VBox>
    </VBox>

    <VBox spacing="15" style="-fx-background-color: #161b22; -fx-padding: 20; -fx-background-radius: 8;">
        <Label text="Startup Preferences" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <CheckBox fx:id="startupToggle" text=" Launch OmniDesk automatically when Windows starts" style="-fx-font-size: 14px;"/>
        <CheckBox fx:id="minimizeToggle" text=" Start minimized in the System Tray (Background mode)" style="-fx-font-size: 14px;"/>

        <Button text="Save Preferences" styleClass="accent" onAction="#handleSaveSettings" style="-fx-margin-top: 10;"/>
        <Label fx:id="statusLabel" text="" style="-fx-text-fill: #3fb950;"/>
    </VBox>

    <Label text="Note: Closing the app with the 'X' will minimize it to the System Tray. Right-click the tray icon to force close." style="-fx-text-fill: gray; -fx-font-style: italic;"/>

</VBox>