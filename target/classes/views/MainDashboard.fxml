<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.omnidesk.controllers.MainController">

    <left>
        <VBox fx:id="sidebar" spacing="10" prefWidth="220" style="-fx-background-color: -color-bg-subtle; -fx-padding: 20;">

            <HBox alignment="CENTER_LEFT" spacing="15">
                <Button text="☰" styleClass="flat" onAction="#toggleSidebar" style="-fx-font-size: 18px; -fx-cursor: hand;"/>
                <Label fx:id="logoLabel" text="OmniDesk" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #58a6ff;"/>
            </HBox>

            <Region prefHeight="20"/>

            <Button fx:id="btnHome" text="🏠 Dashboard" maxWidth="Infinity" alignment="BASELINE_LEFT" styleClass="flat" onAction="#loadOverview"/>
            <Button fx:id="btnFinance" text="💰 Finances" maxWidth="Infinity" alignment="BASELINE_LEFT" styleClass="flat" onAction="#loadFinancesView"/>
            <Button fx:id="btnInventory" text="📦 Inventory" maxWidth="Infinity" alignment="BASELINE_LEFT" styleClass="flat" onAction="#loadInventoryView"/>
            <Button fx:id="btnActivity" text="⏱ Activity" maxWidth="Infinity" alignment="BASELINE_LEFT" styleClass="flat" onAction="#loadActivityView"/>
            <Button fx:id="btnTasks" text="✅ Tasks" maxWidth="Infinity" alignment="BASELINE_LEFT" styleClass="flat" onAction="#loadTasksView"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button fx:id="btnTheme" text="☀️ Light Mode" maxWidth="Infinity" alignment="BASELINE_LEFT" styleClass="flat" onAction="#toggleTheme"/>
            <Button fx:id="btnSettings" text="⚙ Settings" maxWidth="Infinity" alignment="BASELINE_LEFT" styleClass="flat" onAction="#loadSettingsView"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: -color-bg-default;"/>
    </center>

</BorderPane>